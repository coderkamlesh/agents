{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "formatter": true,
  "update": "notify",
  "shell": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
  "permissions": [
  { "action": "read", "resource": "*", "effect": "allow" },
  { "action": "read", "resource": "*.env", "effect": "ask" },
  { "action": "read", "resource": "*.env.*", "effect": "ask" },
  { "action": "read", "resource": "*.env.example", "effect": "allow" },
  { "action": "glob", "resource": "*", "effect": "allow" },
  { "action": "grep", "resource": "*", "effect": "allow" },

  { "action": "edit", "resource": "*", "effect": "ask" },
  { "action": "shell", "resource": "*", "effect": "ask" },

  { "action": "shell", "resource": "pwd", "effect": "allow" },
  { "action": "shell", "resource": "ls*", "effect": "allow" },
  { "action": "shell", "resource": "dir*", "effect": "allow" },
  { "action": "shell", "resource": "Get-ChildItem*", "effect": "allow" },
  { "action": "shell", "resource": "Get-Location*", "effect": "allow" },
  { "action": "shell", "resource": "Test-Path*", "effect": "allow" },

  { "action": "shell", "resource": "git status*", "effect": "allow" },
  { "action": "shell", "resource": "git diff*", "effect": "allow" },
  { "action": "shell", "resource": "git log*", "effect": "allow" },
  { "action": "shell", "resource": "git show*", "effect": "allow" },
  { "action": "shell", "resource": "git branch*", "effect": "allow" },
  { "action": "shell", "resource": "git ls-files*", "effect": "allow" },

  { "action": "shell", "resource": "mvn test-compile*", "effect": "allow" },
  { "action": "shell", "resource": "mvn test -Dtest=*", "effect": "allow" },
  { "action": "shell", "resource": "./mvnw test-compile*", "effect": "allow" },
  { "action": "shell", "resource": "./mvnw test -Dtest=*", "effect": "allow" },

  { "action": "shell", "resource": "git push*", "effect": "ask" },
  { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
  { "action": "shell", "resource": "git clean*", "effect": "deny" },
  { "action": "shell", "resource": "Remove-Item*", "effect": "deny" },
  { "action": "shell", "resource": "rm*", "effect": "deny" },
  { "action": "shell", "resource": "del*", "effect": "deny" },
  { "action": "shell", "resource": "rmdir*", "effect": "deny" },
  { "action": "shell", "resource": "sudo*", "effect": "deny" }
],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "out/**",
      ".next/**",
      "coverage/**",
      "target/**",
      ".venv/**",
      "__pycache__/**",
      "*.log"
    ]
  },
  "compaction": {
    "auto": true,
    "keep": { "tokens": 18000 },
    "buffer": 30000
  },
  "providers": {
    "experiential": {
      "name": "Experiential Labs",
      "env": ["EXPLABS_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.experientiallabs.ai/v1"
      },
      "models": {
        "gpt-6-luna": {
          "name": "GPT Luna",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "settings": {
            "reasoningEffort": "max"
          },
          "variants": [
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "gpt-6.2-astra:free": {
          "name": "GPT ASTRA",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "settings": {
            "reasoningEffort": "medium"
          },
          "variants": [
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        },
        "qwen4-max:free": {
          "name": "QWEN 4 MAX",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "settings": {
            "reasoningEffort": "medium"
          },
          "variants": [
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        }
      }
    },
    "respan": {
      "name": "RESPAN",
      "env": ["EXPLABS_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://gateway.respan.ai/v1"
      },
      "models": {
     
        "gpt-6.2-sol:free": {
          "name": "GPT SOL",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "settings": {
            "reasoningEffort": "medium"
          },
          "variants": [
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        }
      }
    },
    "sarvam": {
      "name": "SARVAM",
      "env": ["SARVAM_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.sarvam.ai/v2"
      },
      "models": {
     
        "deepseekv4.1-flash-1017": {
          "name": "DEEPSEEK V4.1 FLASH",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "settings": {
            "reasoningEffort": "max"
          },
          "variants": [
            { "id": "max", "settings": { "reasoningEffort": "max" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        }
      }
    },
    "apinex": {
      "name": "NEX",
      "env": ["NEX_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.apinex.bond/v1"
      },
      "models": {
        "free/hy4": {
          "name": "HY4",
          "capabilities": {
            "tools": true,
                "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 250000
          },
          "settings": {
            "reasoningEffort": "xhigh"
          },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "free/deepseek-v4.1-flash": {
          "name": "DEEPSEEK FLASH",
          "capabilities": {
            "tools": true,
           "input": ["text", "image"],
            "output": ["text"]
          },
         "limit": {
            "context": 1000000,
            "output": 250000
          },
          "settings": {
            "reasoningEffort": "max"
          },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "free/gpt-6-luna": {
          "name": "GPT-6 Luna",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "settings": {
            "reasoningEffort": "max"
          },
          "variants": [
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        }
      }
    }
  }
}
