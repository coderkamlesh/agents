{
  "$schema": "https://opencode.ai/config.json",
   "instructions":[
      "https://raw.githubusercontent.com/coderkamlesh/cline_agent/master/rules/01-global.md",
      "https://raw.githubusercontent.com/coderkamlesh/cline_agent/master/rules/02-pair-programming.md"
  ],
  "disabled_providers": [],
  "provider": {
    "experientiallabs": {
      "name": "EXP",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.experientiallabs.ai/v1"
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT LUNA",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {           
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "deepseek-v4.1-flash": {
          "name": "DEEPSEEK V4.1 FLASH",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {          
            "high": {
              "reasoningEffort": "high"
            },          
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    }
  },
   "permissions": [
    // ─── Default: sab kuch ask ───
    // Ye base policy ke "* * allow" ko override karta hai
    { "action": "*", "resource": "*", "effect": "ask" },

    // ─── Read-only actions: allow ───
    { "action": "read",      "resource": "*", "effect": "allow" },
    { "action": "glob",      "resource": "*", "effect": "allow" },
    { "action": "grep",      "resource": "*", "effect": "allow" },
    { "action": "skill",     "resource": "*", "effect": "allow" },
    { "action": "webfetch",  "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "question",  "resource": "*", "effect": "allow" },

    // ─── .env protection (read * allow ke BAAD, warna override ho jayega) ───
    { "action": "read", "resource": "*.env",         "effect": "ask" },
    { "action": "read", "resource": "*.env.*",       "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    // ─── Edit ───
    { "action": "edit", "resource": "*", "effect": "ask" },

    // ─── Shell: read-only git commands allow ───
    { "action": "shell", "resource": "git status*",         "effect": "allow" },
    { "action": "shell", "resource": "git log*",            "effect": "allow" },
    { "action": "shell", "resource": "git diff*",           "effect": "allow" },
    { "action": "shell", "resource": "git show*",           "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse*",      "effect": "allow" },
    { "action": "shell", "resource": "git remote -v",       "effect": "allow" },
    { "action": "shell", "resource": "git -C * status*",    "effect": "allow" },
    { "action": "shell", "resource": "git -C * log*",       "effect": "allow" },
    { "action": "shell", "resource": "git -C * diff*",      "effect": "allow" },
    { "action": "shell", "resource": "git -C * show*",      "effect": "allow" },
    { "action": "shell", "resource": "git -C * rev-parse*", "effect": "allow" },
    { "action": "shell", "resource": "git -C * remote -v",  "effect": "allow" },

    // ─── Shell: explicitly ask (documentation ke liye — default already ask hai) ───
    { "action": "shell", "resource": "git add*",    "effect": "ask" },
    { "action": "shell", "resource": "git commit*", "effect": "ask" },
    { "action": "shell", "resource": "git push*",   "effect": "ask" },
    { "action": "shell", "resource": "tee *",       "effect": "ask" },
    { "action": "shell", "resource": "cat *>*",     "effect": "ask" },
    { "action": "shell", "resource": "echo *>*",    "effect": "ask" },
    { "action": "shell", "resource": "printf *>*",  "effect": "ask" },

    // ─── Shell: hard deny — ALWAYS LAST ───
    { "action": "shell", "resource": "rm *",    "effect": "deny" },
    { "action": "shell", "resource": "rmdir *", "effect": "deny" }
  ]
}
